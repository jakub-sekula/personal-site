# Copy to .env (git-ignored). Only needed for `pnpm photos sync`.
# R2 → Manage API tokens → "Object Read & Write" scoped to the photos bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=photos

# Where the site loads photos from. Leave unset locally (serves public/photos).
# Set this in the Cloudflare Pages build settings, e.g. https://photos.jakubsekula.com
# PUBLIC_PHOTOS_URL=
