---
// /dev/photos: the local photo editor (dev only; see ./index.mjs). A React app
// built with shadcn/ui (./app), with its own stylesheet (imported by App.tsx) rather
// than the site's.
import App from './app/App';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Photos · local editor</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <script is:inline>
      // Same theme as the site: dark unless chosen otherwise (localStorage "theme").
      try {
        const theme = localStorage.getItem('theme');
        const dark = theme === 'light' ? false : theme === 'system' ? matchMedia('(prefers-color-scheme: dark)').matches : true;
        document.documentElement.classList.toggle('dark', dark);
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
      } catch {}
    </script>
  </head>
  <body>
    <App client:only="react" />
  </body>
</html>
