---
// /dev/photos: local photo editor (dev only; see ./index.mjs). The page is a shell;
// the script loads albums from the dev API and saves edits back to the album files.
import Base from '../../src/layouts/Base.astro';

const control =
  'rounded-xs border border-text/15 bg-transparent px-2 py-1 placeholder:opacity-50 focus:border-js-yellow focus:outline-none dark:border-darktext/15';
const field = `${control} w-full`;
const button =
  'rounded-xs border border-text/15 px-2 py-1 hover:border-js-yellow disabled:cursor-default disabled:opacity-40 dark:border-darktext/15';
---

<Base title="Photo editor" noindex>
  <div class="min-h-screen px-4 pb-16 md:px-6">
    <header
      class="sticky top-0 z-10 -mx-4 mb-6 flex flex-wrap items-center gap-3 border-b border-text/10 bg-lightbg/90 px-4 py-3 text-sm backdrop-blur-md md:-mx-6 md:px-6 dark:border-darktext/10 dark:bg-darkbg/90"
    >
      <h1 class="font-heading text-lg font-semibold">
        Photo editor <span class="text-xs font-light opacity-60">only in dev · edits save to the album files</span>
      </h1>
      <select id="album-filter" class={control}>
        <option value="">All albums</option>
      </select>
      <input id="search" type="search" placeholder="Search name, title or tag" class:list={[control, 'w-56']} />
      <label class="flex items-center gap-1.5"><input id="untitled" type="checkbox" /> Only untitled</label>
      <span id="selection" class="ml-auto opacity-75"></span>
      <button id="copy-gallery" class={button} disabled>Copy &lt;Gallery&gt;</button>
      <button id="clear-selection" class={button} disabled>Clear selection</button>
    </header>

    <p id="loading" class="opacity-60">Loading photos…</p>
    <div id="albums" class="flex flex-col gap-12"></div>

    <div
      id="toast"
      class="pointer-events-none fixed bottom-6 left-1/2 -translate-x-1/2 rounded-md bg-text px-4 py-2 text-sm text-white opacity-0 transition-opacity dark:bg-darktext dark:text-text"
    >
    </div>
  </div>

  <template id="album-template">
    <section>
      <header class="mb-4 flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <h2 class="font-heading text-2xl font-semibold" data-title></h2>
        <span class="text-sm opacity-60" data-count></span>
        <a class="text-sm underline" data-link target="_blank">Album page ↗</a>
      </header>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 2xl:grid-cols-5" data-grid></div>
    </section>
  </template>

  <template id="photo-template">
    <article class="group/card rounded-card flex flex-col overflow-hidden transition-shadow data-selected:ring-2 data-selected:ring-js-yellow">
      <button type="button" class="relative aspect-3/2 bg-black/20" data-thumb title="Select for a gallery snippet">
        <img alt="" loading="lazy" class="absolute inset-0 size-full object-contain" />
        <span
          class="absolute top-2 left-2 hidden rounded-full bg-js-yellow px-2 text-xs font-bold text-black group-data-selected/card:inline"
          data-order></span>
        <span class="absolute top-2 right-2 hidden rounded-xs bg-black/70 px-1.5 text-xs text-white" data-cover-badge>Cover</span>
      </button>
      <form class="flex flex-col gap-2 p-3 text-sm">
        <div class="flex items-center justify-between gap-2">
          <code class="truncate text-xs opacity-70" data-name></code>
          <span class="shrink-0 text-xs" data-status></span>
        </div>
        <input name="title" placeholder="Title" class={field} />
        <textarea name="description" rows="3" placeholder="Description (Markdown)" class={field}></textarea>
        <input name="tags" placeholder="Tags, comma separated" class={field} />
        <details class="flex flex-col gap-2">
          <summary class="cursor-pointer text-xs opacity-70">Alt text and address</summary>
          <input name="alt" placeholder="Alt text (defaults to the title)" class:list={[field, 'mt-2']} />
          <input name="slug" placeholder="Address (defaults to the file name)" class:list={[field, 'mt-2']} />
        </details>
        <div class="flex flex-wrap gap-2 pt-1 text-xs">
          <button type="button" class={button} data-copy-photo>Copy &lt;Photo&gt;</button>
          <button type="button" class={button} data-copy-src>Copy name</button>
          <button type="button" class={button} data-set-cover>Set as cover</button>
          <a class={button} data-page target="_blank">Page ↗</a>
        </div>
      </form>
    </article>
  </template>
</Base>

<script>
  interface Photo {
    src: string;
    id: string;
    name: string;
    thumb?: number;
    title: string;
    description: string;
    tags: string[];
    alt: string;
    slug: string;
    href: string;
  }
  interface Album {
    id: string;
    title: string;
    draft: boolean;
    coverId?: string;
    photos: Photo[];
  }

  // Saving rewrites an album file, and Astro reloads every open page when content
  // changes. Keep this page (and its filters, selection and scroll) as it is: Vite
  // only reloads when the reload's `path` matches the page, so point it elsewhere.
  // Other tabs still reload and show the change.
  import.meta.hot?.on('vite:beforeFullReload', (payload: { path?: string }) => {
    payload.path = '/__photo-editor-stays-open__.html';
  });

  const API = '/dev/api/photos';
  // Thumbnails come from the local copies; fall back to R2 if they aren't on this machine.
  const LOCAL = '/photos';
  const REMOTE = import.meta.env.PUBLIC_PHOTOS_URL || 'https://photos.jakubsekula.com';

  const $ = <T extends HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector<T>(sel)!;
  const albumsEl = $('#albums');
  const selection: { card: HTMLElement; ref: string }[] = [];

  function toast(message: string) {
    const el = $('#toast');
    el.textContent = message;
    el.style.opacity = '1';
    clearTimeout(Number(el.dataset.timer));
    el.dataset.timer = String(setTimeout(() => (el.style.opacity = '0'), 1800));
  }

  async function copy(text: string) {
    await navigator.clipboard.writeText(text);
    toast(`Copied ${text.length > 60 ? text.slice(0, 57) + '…' : text}`);
  }

  async function post(path: string, body: unknown) {
    const res = await fetch(API + path, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const json = await res.json();
    if (!res.ok) throw new Error(json.error ?? res.statusText);
    return json;
  }

  function updateSelection() {
    selection.forEach(({ card }, i) => ($('[data-order]', card).textContent = String(i + 1)));
    $('#selection').textContent = selection.length ? `${selection.length} selected` : '';
    $<HTMLButtonElement>('#copy-gallery').disabled = !selection.length;
    $<HTMLButtonElement>('#clear-selection').disabled = !selection.length;
  }

  function photoCard(album: Album, photo: Photo, ref: string) {
    const card = ($<HTMLTemplateElement>('#photo-template').content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
    const form = $<HTMLFormElement>('form', card);
    const status = $('[data-status]', card);
    card.dataset.search = [photo.name, photo.title, ...photo.tags].join(' ').toLowerCase();
    card.dataset.untitled = String(!photo.title);

    const img = $<HTMLImageElement>('img', card);
    const path = `/${album.id}/${photo.id}/${photo.thumb ?? 640}.webp`;
    img.src = LOCAL + path;
    img.onerror = () => {
      img.onerror = null;
      img.src = REMOTE + path;
    };
    $('[data-name]', card).textContent = ref;
    $<HTMLAnchorElement>('[data-page]', card).href = photo.href;
    $('[data-cover-badge]', card).classList.toggle('hidden', album.coverId !== photo.id);

    const inputs = form.elements as unknown as Record<string, HTMLInputElement>;
    inputs.title.value = photo.title;
    inputs.description.value = photo.description;
    inputs.tags.value = photo.tags.join(', ');
    inputs.alt.value = photo.alt;
    inputs.slug.value = photo.slug;

    // Save the whole photo whenever a field changes (on blur).
    form.addEventListener('change', async () => {
      status.textContent = 'Saving…';
      status.className = 'shrink-0 text-xs opacity-60';
      try {
        const { saved } = await post('/photo', {
          album: album.id,
          src: photo.src,
          fields: {
            title: inputs.title.value,
            description: inputs.description.value,
            tags: inputs.tags.value.split(','),
            alt: inputs.alt.value,
            slug: inputs.slug.value,
          },
        });
        inputs.tags.value = saved.tags.join(', ');
        card.dataset.search = [photo.name, saved.title, ...saved.tags].join(' ').toLowerCase();
        card.dataset.untitled = String(!saved.title);
        if (saved.slug || inputs.slug.value === '') {
          $<HTMLAnchorElement>('[data-page]', card).href = `/photography/${album.id}/${saved.slug || photo.name}`;
        }
        status.textContent = 'Saved ✓';
        status.className = 'shrink-0 text-xs text-js-green';
      } catch (error) {
        status.textContent = (error as Error).message;
        status.className = 'shrink-0 text-xs text-js-red';
      }
    });
    form.addEventListener('submit', (e) => e.preventDefault());

    $('[data-copy-photo]', card).addEventListener('click', () => copy(`<Photo src="${ref}" />`));
    $('[data-copy-src]', card).addEventListener('click', () => copy(ref));
    $('[data-set-cover]', card).addEventListener('click', async () => {
      try {
        await post('/cover', { album: album.id, src: `${album.id}/${photo.id}` });
        albumsEl.querySelectorAll(`[data-album="${album.id}"] [data-cover-badge]`).forEach((b) => b.classList.add('hidden'));
        $('[data-cover-badge]', card).classList.remove('hidden');
        toast(`Cover of ${album.title} set`);
      } catch (error) {
        toast((error as Error).message);
      }
    });
    $('[data-thumb]', card).addEventListener('click', () => {
      const at = selection.findIndex((s) => s.card === card);
      if (at >= 0) {
        selection.splice(at, 1);
        delete card.dataset.selected;
      } else {
        selection.push({ card, ref });
        card.dataset.selected = '';
      }
      updateSelection();
    });
    return card;
  }

  function applyFilters() {
    const album = $<HTMLSelectElement>('#album-filter').value;
    const query = $<HTMLInputElement>('#search').value.trim().toLowerCase();
    const untitled = $<HTMLInputElement>('#untitled').checked;
    albumsEl.querySelectorAll<HTMLElement>('[data-album]').forEach((section) => {
      let shown = 0;
      section.querySelectorAll<HTMLElement>('[data-search]').forEach((card) => {
        const visible = (!query || card.dataset.search!.includes(query)) && (!untitled || card.dataset.untitled === 'true');
        card.hidden = !visible;
        if (visible) shown++;
      });
      section.hidden = (!!album && section.dataset.album !== album) || shown === 0;
    });
  }

  async function load() {
    const { albums } = (await (await fetch(API)).json()) as { albums: Album[] };
    const select = $<HTMLSelectElement>('#album-filter');
    for (const album of albums) {
      if (!album.photos.length) continue;
      select.add(new Option(`${album.title}${album.draft ? ' (draft)' : ''}`, album.id));

      const section = ($<HTMLTemplateElement>('#album-template').content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
      section.dataset.album = album.id;
      $('[data-title]', section).textContent = album.title;
      $('[data-count]', section).textContent = `${album.photos.length} photos`;
      $<HTMLAnchorElement>('[data-link]', section).href = `/photography/${album.id}`;
      // Short references ("iceland/dscf-1434") unless two photos share a file name.
      const nameCount = new Map<string, number>();
      album.photos.forEach((p) => nameCount.set(p.name, (nameCount.get(p.name) ?? 0) + 1));
      const grid = $('[data-grid]', section);
      for (const photo of album.photos) {
        const ref = `${album.id}/${nameCount.get(photo.name)! > 1 ? photo.id : photo.name}`;
        grid.append(photoCard(album, photo, ref));
      }
      albumsEl.append(section);
    }
    $('#loading').remove();
    applyFilters();
  }

  $('#album-filter').addEventListener('change', applyFilters);
  $('#search').addEventListener('input', applyFilters);
  $('#untitled').addEventListener('change', applyFilters);
  $('#copy-gallery').addEventListener('click', () =>
    copy(`<Gallery photos={[${selection.map(({ ref }) => `{ src: '${ref}' }`).join(', ')}]} />`),
  );
  $('#clear-selection').addEventListener('click', () => {
    selection.splice(0).forEach(({ card }) => delete card.dataset.selected);
    updateSelection();
  });

  load().catch((error) => ($('#loading').textContent = `Couldn't load photos: ${error.message}`));
</script>
