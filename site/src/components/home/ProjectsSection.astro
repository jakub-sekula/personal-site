---
// Port of components/home/ProjectsSection.tsx: featured projects large and
// alternating, the rest as small cards under "Other projects".
import type { CollectionEntry } from 'astro:content';
import { getEntries } from 'astro:content';
import { Image } from 'astro:assets';
import SectionContainer from './SectionContainer.astro';
import Hyperlink from '../common/Hyperlink.astro';
import Tag from '../common/Tag.astro';
import ProjectCard from '../common/ProjectCard.astro';
import { tagSlug } from '../../lib/content';

interface Props {
  title: string;
  projects: CollectionEntry<'projects'>[];
}

const { title, projects } = Astro.props;
const featured = await Promise.all(
  projects
    .filter((p) => p.data.featured)
    .map(async (p) => ({ project: p, tools: (await getEntries(p.data.tools)).filter((t) => t.data.showOnHomepage) })),
);
const others = projects.filter((p) => !p.data.featured);
---

<SectionContainer title={title}>
  <div class="relative grid w-full grid-cols-12 md:gap-12 lg:gap-16 lg:gap-y-24">
    {
      featured.map(({ project, tools }, index) => (
        <div class="relative col-span-full grid grid-rows-1 gap-6 md:grid-cols-2 md:gap-12 xl:col-span-10 xl:col-start-2">
          <div
            class:list={[
              'absolute left-1/2  top-1/2 -z-50 h-full max-h-[75px]  w-full max-w-[300px]  -translate-y-1/2 rounded-full  bg-linear-to-t from-blue-500 to-blue-300  opacity-0 blur-[100px] dark:opacity-100',
              index % 2 === 0 ? '-translate-x-3/4' : '-translate-x-1/4',
            ]}
          />
          <div
            class={`group relative w-full overflow-hidden rounded-md bg-js-yellow object-cover md:aspect-video md:w-[125%] ${
              index % 2 === 0 ? 'md:col-start-1 md:place-self-end' : 'md:col-start-2 md:place-self-start'
            } `}
          >
            <div class=" absolute z-0 h-0 w-full" />
            <a href={`/projects/${project.id}`}>
              <Image
                src={project.data.cover}
                alt={project.data.title}
                widths={[750, 1000, 1500]}
                sizes="(min-width: 1280px) 700px, (min-width: 768px) 60vw, 100vw"
                class="z-50 h-full w-full rounded-md object-cover transition-all duration-500 ease-out group-hover:scale-105"
              />
            </a>
          </div>
          <div
            class:list={[
              'mb-4 flex h-min flex-col gap-4 md:row-start-1 md:mb-0 md:place-self-center',
              index % 2 === 0 ? 'md:col-start-2' : 'md:col-start-1',
            ]}
          >
            <a href={`/projects/${project.id}`} class="hover-group w-fit">
              <h3 class="animate-underline mb-1 font-heading text-3xl font-semibold leading-none md:text-4xl">
                {project.data.title}
              </h3>
            </a>
            {project.data.tags.length > 0 && (
              <ul class="flex flex-wrap gap-2">
                {project.data.tags.map((tag) => (
                  <Tag href={`/tags/${tagSlug(tag)}`} title={tag} />
                ))}
              </ul>
            )}
            {project.data.excerpt && <p class="font-light leading-normal md:leading-snug">{project.data.excerpt}</p>}
            {tools.length > 0 && (
              <div class="flex gap-2">
                {tools.map((tool) => {
                  const icon = tool.data.iconDark ?? tool.data.icon;
                  return icon && <img src={icon.src} width={icon.width} height={icon.height} alt={tool.data.name} class="h-6 w-6 opacity-75 " />;
                })}
              </div>
            )}
            <Hyperlink href={`/projects/${project.id}`} class="text-sm" />
          </div>
        </div>
      ))
    }

    {
      others.length > 0 && (
        <div class="col-span-full flex flex-wrap justify-center gap-4">
          <h2 class="font-heading text-2xl font-semibold md:mb-4 md:text-4xl text-center w-full">Other projects</h2>
          {others.map((project, index) => (
            <ProjectCard project={project} class={others.length === 3 && index === 0 ? 'lg:col-start-2' : ''} />
          ))}
        </div>
      )
    }
  </div>
  <Hyperlink title="View all projects" href="/projects" class="reveal fade-bottom  place-self-end md:place-self-auto" />
</SectionContainer>
