---
// Port of components/home/Hero.tsx
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  home: CollectionEntry<'home'>['data'];
}

const { headline, avatar, background, socials } = Astro.props.home;
---

<section
  id="hero-section"
  class="relative -mt-16 mb-16 grid w-full grid-cols-12 gap-4 overflow-hidden bg-gradient-to-tl from-slate-950 to-slate-800 px-10 py-24 pt-40 md:px-8 xl:min-h-[70vh]"
>
  <div class="patterned absolute inset-0"></div>
  <Image
    src={background}
    alt=""
    widths={[750, 1000, 1920]}
    sizes="100vw"
    loading="eager"
    class="absolute inset-0 h-full w-full object-cover mix-blend-multiply"
  />
  <div
    class="z-10 col-span-full flex flex-col items-center justify-center text-center text-xl font-light
          md:flex-row md:gap-16 md:text-left"
  >
    <Image
      src={avatar}
      alt="Jakub Sekula"
      widths={[384, 576]}
      sizes="(min-width: 768px) 288px, 192px"
      loading="eager"
      class="mb-8 h-48 w-48 shrink-0 rounded-full bg-gradient-to-tr from-amber-200 to-amber-600 shadow-xl shadow-slate-950 md:mb-0 md:h-72 md:w-72"
    />
    <div class="flex max-w-2xl flex-col text-white md:block">
      <h1 class="font-heading text-3xl font-semibold tracking-tight md:text-4xl lg:text-6xl">{headline}</h1>
      <h2 class="mb-4 text-lg font-light md:mb-0 md:text-xl md:leading-snug lg:text-2xl">
        I am a <span class="font-semibold text-js-blue">web developer</span>,<span class="font-semibold text-js-green"
          >{' '}mechanical engineer</span
        >, <br class="hidden md:block" />and a<span class="font-semibold text-js-red">{' '}photography enthusiast</span>.
      </h2>
      <div class="col-span-full mx-auto mb-6 mt-3 flex gap-4 text-base">
        {
          socials.map((social) => (
            <a href={social.url} class="group flex w-max items-center gap-2 hover:underline">
              <img src={social.icon.src} width="18" height="18" alt={`${social.name}-icon`} />
              {social.name}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
