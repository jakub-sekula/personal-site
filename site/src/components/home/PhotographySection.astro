---
// Port of components/home/PhotographySection.jsx
import type { CollectionEntry } from 'astro:content';
import SectionContainer from './SectionContainer.astro';
import Hyperlink from '../common/Hyperlink.astro';
import Picture from '../photos/Picture.astro';

interface Props {
  albums: CollectionEntry<'albums'>[];
}
---

<SectionContainer title="Photography">
  <div class="relative grid w-full grid-cols-12 gap-4">
    {
      Astro.props.albums.map((album) => (
        <a
          href={`/photography/${album.id}`}
          class=" group relative aspect-[2.5] md:aspect-3/2 col-span-full md:col-span-6 xl:col-span-4 flex w-full flex-col items-center
    justify-center gap-4 overflow-hidden rounded-md border border-text/10 px-3 py-6 font-bold dark:border-0"
          style="animation-delay: 0ms; transition-delay: 0ms"
        >
          <Picture
            src={album.data.cover}
            alt={album.data.title}
            sizes="(min-width: 1280px) 33vw, (min-width: 768px) 50vw, 100vw"
            placeholder={false}
            class="absolute -z-10 h-full w-full object-cover transition-all duration-500 ease-out group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-linear-to-tr from-darkbg/50" />
          <h4 class="z-10 font-heading text-2xl font-semibold uppercase text-white">{album.data.title}</h4>
        </a>
      ))
    }
  </div>
  <Hyperlink title="Go to photography page" href="/photography" />
</SectionContainer>
