---
// Port of components/common/SectionHeading.jsx
interface Props {
  title: string;
  color?: 'red' | 'green' | 'blue' | 'yellow';
  class?: string;
}

const { title, color, class: className } = Astro.props;
const colors = { red: 'bg-js-red ', green: 'bg-js-green ', blue: ' bg-js-blue', yellow: 'bg-js-yellow ' };
const id = title.replace(/[^\w\s$*_+~.()'"!\-:@]+/g, '').trim().replace(/\s+/g, '-');
---

<div class={`flex flex-col ${className}`}>
  <h2 class="text-xl font-heading font-semibold capitalize" id={id}>{title}</h2>
  <span class={`w-16 h-0.5 ${(color && colors[color]) || 'bg-js-yellow'}`}></span>
</div>
