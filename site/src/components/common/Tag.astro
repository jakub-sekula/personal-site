---
// Port of components/common/Tag.tsx
interface Props {
  title: string;
  href?: string;
}

const { title, href } = Astro.props;
const Element = href ? 'a' : 'span';
---

<Element href={href} class="w-fit rounded-xs bg-text px-2 py-0.5
		text-xs text-white dark:bg-darktext dark:text-text">{title}</Element>
