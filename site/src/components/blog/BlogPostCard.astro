---
// Port of components/blog/BlogPostCard.jsx
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, cover, tags, description } = post.data;
const excerpt = description ?? post.body?.trim();
---

<a
  href={`/blog/${post.id}`}
  class="duration-250 hover-group rounded-card group relative col-span-full flex w-full flex-col  overflow-hidden transition-all hover:-translate-y-1 md:col-span-6 lg:col-span-4"
>
  {
    cover ? (
      <Image src={cover} alt={title} widths={[500, 750]} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" class="aspect-video h-36 w-full object-cover md:h-full" />
    ) : (
      <div class="aspect-video w-full bg-text" />
    )
  }
  <div class="flex flex-col p-3">
    <h3 class="animate-underline w-fit font-heading text-lg
					 font-semibold line-clamp-3">{title}</h3>
    {excerpt && <p class="mt-3 text-sm font-light line-clamp-2">{excerpt}</p>}
    {
      tags.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-2">
          {tags.slice(0, 3).map((tag) => (
            <span class="rounded-xs bg-darkbg px-2 py-0.5 text-xs
								 text-darktext dark:bg-darktext dark:text-text">{tag}</span>
          ))}
        </ul>
      )
    }
  </div>
</a>
