---
// PhotoSwipe lightbox for a gallery. The gallery markup is plain HTML: any
// element inside #target with data-slide="<index>" opens that slide.
//
// Galleries inside an element with [data-lightbox-group] (e.g. a post) share
// one lightbox, in page order, so it steps through every photo on the page.
//
// Each photo has its own page. While the lightbox is open, the address bar
// shows the current photo's page (so it can be copied or shared) and the back
// button closes the lightbox. Cmd/Ctrl-click still opens the page itself.
import type { LightboxSlide } from '../../lib/lightbox';

interface Props {
  target: string;
  slides: LightboxSlide[];
  /**
   * For photo pages: closing on a different photo than the one it was opened
   * on goes to that photo's page (instead of back to where it was opened).
   */
  closeToPage?: boolean;
}

const { target, slides, closeToPage = false } = Astro.props;
// JSON inside <script>: escape "<" so a description can't close the tag.
const json = JSON.stringify(slides).replace(/</g, '\\u003c');
---

<script type="application/json" data-lightbox={target} data-close-to-page={closeToPage ? '' : undefined} set:html={json} />

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import type PhotoSwipe from 'photoswipe';
  import 'photoswipe/style.css';
  import { Check, ChevronLeft, GalleryThumbnails, Link as LinkIcon, X, ZoomIn, ZoomOut } from 'lucide-static';
  import type { LightboxSlide } from '../../lib/lightbox';

  // The thumbnail strip along the bottom can be hidden (its button or "t");
  // remembered across visits.
  const THUMBS = 76; // px; keep in sync with .lightbox-thumbs in global.css
  const THUMBS_KEY = 'lightbox-thumbs-hidden';
  let thumbsHidden = (() => {
    try {
      return localStorage.getItem(THUMBS_KEY) === '1';
    } catch {
      return false;
    }
  })();

  // Lucide icons for PhotoSwipe's buttons (styled in global.css, .pswp__icn.lucide).
  const icon = (svg: string) => svg.trim().replace('class="lucide', 'class="pswp__icn lucide');
  const LINK_ICON = icon(LinkIcon);
  const COPIED_ICON = icon(Check);

  /** Reflect the current photo and the strip's state in PhotoSwipe's root classes and buttons. */
  function applyState(pswp: PhotoSwipe, slide: LightboxSlide | undefined, thumbs: boolean) {
    const root = pswp.element!;
    root.classList.toggle('pswp--has-link', !!slide?.href);
    root.classList.toggle('pswp--thumbs', thumbs && !thumbsHidden);
    const button = root.querySelector('.lightbox-thumbs-button');
    button?.setAttribute('aria-pressed', String(!thumbsHidden));
    button?.setAttribute('title', thumbsHidden ? 'Show thumbnails (t)' : 'Hide thumbnails (t)');
  }
  const escape = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  function captionHtml(slide: LightboxSlide) {
    const parts = [
      slide.title && `<p class="font-heading text-lg font-semibold">${escape(slide.title)}</p>`,
      slide.descriptionHtml && `<div class="lightbox-description text-sm font-light opacity-90">${slide.descriptionHtml}</div>`,
    ].filter(Boolean);
    return parts.length ? `<div class="flex max-w-3xl flex-col gap-1.5">${parts.join('')}</div>` : '';
  }

  async function copyText(text: string) {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const area = Object.assign(document.createElement('textarea'), { value: text });
      area.style.cssText = 'position:fixed;opacity:0';
      document.body.append(area);
      area.select();
      document.execCommand('copy');
      area.remove();
    }
  }

  // Slide elements in a gallery root; on photo pages the root itself is one.
  const tilesIn = (root: HTMLElement) => [...(root.matches('[data-slide]') ? [root] : []), ...root.querySelectorAll<HTMLElement>('[data-slide]')];

  /** One lightbox over one or more galleries (their data blocks, in page order). */
  function setup(blocks: HTMLScriptElement[]) {
    const roots: HTMLElement[] = [];
    const slides: LightboxSlide[] = [];
    for (const block of blocks) {
      const root = document.getElementById(block.dataset.lightbox!);
      if (!root) continue;
      // Renumber this gallery's tiles to follow the galleries before it.
      const offset = slides.length;
      if (offset) tilesIn(root).forEach((tile) => (tile.dataset.slide = String(offset + Number(tile.dataset.slide))));
      roots.push(root);
      slides.push(...JSON.parse(block.textContent!));
    }
    if (!roots.length) return;
    const closeToPage = blocks[0].dataset.closeToPage !== undefined;
    const hasThumbs = slides.length > 1;
    // The element for a slide (a gallery tile, or the big photo on a photo page).
    const tileFor = (index: number) => {
      for (const root of roots) {
        const tile = tilesIn(root).find((t) => t.dataset.slide === String(index));
        if (tile) return tile;
      }
      return null;
    };

    const lightbox = new PhotoSwipeLightbox({
      dataSource: slides.map(({ src, srcset, width, height, msrc, alt, thumbCropped }) => ({ src, srcset, width, height, msrc, alt, thumbCropped })),
      pswpModule: () => import('photoswipe'),
      bgOpacity: 0.95,
      showHideAnimationType: 'zoom',
      arrowPrevSVG: icon(ChevronLeft),
      arrowNextSVG: icon(ChevronLeft), // PhotoSwipe mirrors it for "next"
      closeSVG: icon(X),
      zoomSVG: icon(ZoomIn) + icon(ZoomOut), // CSS shows the one that applies
      // PhotoSwipe would refocus the tile that was clicked, scrolling back to it;
      // we focus the tile of the photo being closed instead (see 'destroy').
      returnFocus: false,
      // Make room for the thumbnail strip.
      paddingFn: () => ({ top: 0, bottom: hasThumbs && !thumbsHidden ? THUMBS : 0, left: 0, right: 0 }),
    });

    // Zoom in from (and back out to) the thumbnail that was clicked. Album tiles
    // have a blurred copy behind portrait photos, so use the last <img>.
    lightbox.addFilter('thumbEl', (thumbEl, _data, index) => {
      const imgs = tileFor(index)?.querySelectorAll('img');
      // Without a thumbnail PhotoSwipe falls back to a fade.
      return (imgs?.length ? imgs[imgs.length - 1] : thumbEl) as HTMLElement;
    });

    // Caption over the bottom of the photo, thumbnail strip, and top-bar buttons
    // for copying the link and showing/hiding the strip.
    lightbox.on('uiRegister', () => {
      const ui = lightbox.pswp!.ui!;
      ui.registerElement({
        name: 'caption',
        order: 10,
        isButton: false,
        appendTo: 'root',
        onInit: (el: HTMLElement, pswp: PhotoSwipe) => {
          el.className =
            'lightbox-caption pswp__hide-on-close pointer-events-none absolute inset-x-0 bottom-0 bg-linear-to-t from-black/80 to-transparent px-5 pt-16 pb-6 text-white [&_a]:pointer-events-auto';
          const render = () => {
            const slide = slides[pswp.currIndex];
            applyState(pswp, slide, hasThumbs);
            el.innerHTML = slide ? captionHtml(slide) : '';
            el.hidden = !el.innerHTML;
          };
          pswp.on('change', render);
          render();
        },
      });

      // Copy the photo page's full address (the photos that have one).
      ui.registerElement({
        name: 'copy-link',
        order: 13,
        isButton: true,
        appendTo: 'bar',
        title: 'Copy link',
        html: LINK_ICON,
        onInit: (el: HTMLElement) => el.classList.add('lightbox-copy-button'),
        onClick: async (_e: MouseEvent, el: HTMLElement, pswp: PhotoSwipe) => {
          const href = slides[pswp.currIndex]?.href;
          if (!href) return;
          await copyText(new URL(href, location.origin).href);
          el.innerHTML = COPIED_ICON;
          el.title = 'Link copied';
          clearTimeout(Number(el.dataset.timer));
          el.dataset.timer = String(
            setTimeout(() => {
              el.innerHTML = LINK_ICON;
              el.title = 'Copy link';
            }, 1500),
          );
        },
      });

      if (hasThumbs) {
        // Show/hide the strip (button or "t"); the photo takes (or gives back) its space.
        const toggleThumbs = (pswp: PhotoSwipe) => {
          thumbsHidden = !thumbsHidden;
          try {
            localStorage.setItem(THUMBS_KEY, thumbsHidden ? '1' : '0');
          } catch {}
          applyState(pswp, slides[pswp.currIndex], hasThumbs);
          pswp.updateSize(true); // re-run paddingFn
        };
        ui.registerElement({
          name: 'thumbs',
          order: 14,
          isButton: true,
          appendTo: 'bar',
          html: icon(GalleryThumbnails),
          onInit: (el: HTMLElement, pswp: PhotoSwipe) => {
            el.classList.add('lightbox-thumbs-button');
            applyState(pswp, slides[pswp.currIndex], hasThumbs);
            pswp.on('keydown', (e) => {
              const key = (e.originalEvent as KeyboardEvent).key;
              if (key === 't' || key === 'T') {
                e.preventDefault();
                toggleThumbs(pswp);
              }
            });
          },
          onClick: (_e: MouseEvent, _el: HTMLElement, pswp: PhotoSwipe) => toggleThumbs(pswp),
        });
        ui.registerElement({
          name: 'thumb-strip',
          order: 11,
          isButton: false,
          appendTo: 'root',
          onInit: (el: HTMLElement, pswp: PhotoSwipe) => setupThumbs(el, pswp),
        });
      }
    });

    // Thumbnail strip along the bottom: every photo in the gallery, the current
    // one highlighted and kept in view; click one to jump to it.
    function setupThumbs(el: HTMLElement, pswp: PhotoSwipe) {
      el.className = 'lightbox-thumbs pswp__hide-on-close absolute inset-x-0 bottom-0 flex items-center gap-3 overflow-x-auto px-5';
      el.innerHTML = slides
        .map(
          (s, i) =>
            `<button type="button" data-thumb="${i}" aria-label="${escape(s.title || s.alt || `Photo ${i + 1}`)}">` +
            `<img src="${escape(s.msrc)}" alt="" loading="lazy" decoding="async" draggable="false"></button>`,
        )
        .join('');
      const buttons = [...el.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
      el.addEventListener('click', (e) => {
        const button = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-thumb]');
        if (button) pswp.goTo(Number(button.dataset.thumb));
      });
      // A mouse wheel scrolls the strip sideways.
      el.addEventListener(
        'wheel',
        (e) => {
          if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
          e.preventDefault();
          el.scrollLeft += e.deltaY;
        },
        { passive: false },
      );
      let first = true;
      const update = () => {
        buttons.forEach((b, i) => b.toggleAttribute('aria-current', i === pswp.currIndex));
        const current = buttons[pswp.currIndex];
        if (!current) return;
        const left = current.offsetLeft - (el.clientWidth - current.offsetWidth) / 2;
        el.scrollTo({ left, behavior: first ? 'instant' : 'smooth' });
        first = false;
      };
      pswp.on('change', update);
      // Layout isn't ready until the lightbox is shown (and after the strip is toggled back on).
      pswp.on('openingAnimationStart', update);
      pswp.on('resize', update);
    }

    // Keep the address bar and tab title on the photo being shown.
    let pushedHistory = false;
    let pageTitle = '';
    let openedAt = -1;
    const showInUrl = (index: number) => {
      const slide = slides[index];
      if (!slide?.href) return;
      history.replaceState(history.state, '', slide.href);
      if (slide.pageTitle) document.title = slide.pageTitle;
    };
    // Scroll the page behind the lightbox so the current photo's tile is on screen:
    // closing then lands on it, and the zoom-out animation goes back into it.
    const keepTileInView = (index: number) => {
      const tile = tileFor(index);
      if (!tile) return;
      const { top, bottom } = tile.getBoundingClientRect();
      const header = 64; // the fixed site header
      if (top < header || bottom > window.innerHeight) tile.scrollIntoView({ block: 'center', behavior: 'instant' });
    };

    lightbox.on('change', () => {
      showInUrl(lightbox.pswp!.currIndex);
      keepTileInView(lightbox.pswp!.currIndex);
    });
    // Keyboard focus continues from the photo you were on, without scrolling.
    // No focus ring for this (it isn't the user moving focus); Tab still shows rings as usual.
    lightbox.on('destroy', () => {
      const tile = tileFor(lightbox.pswp?.currIndex ?? -1);
      if (!tile) return;
      tile.dataset.lightboxFocus = '';
      tile.addEventListener('blur', () => delete tile.dataset.lightboxFocus, { once: true });
      tile.focus({ preventScroll: true });
    });
    lightbox.on('close', () => {
      document.title = pageTitle;
      if (!pushedHistory) return;
      pushedHistory = false;
      const current = slides[lightbox.pswp!.currIndex];
      if (closeToPage && lightbox.pswp!.currIndex !== openedAt && current?.href) {
        location.replace(current.href); // land on the page of the photo you ended on
      } else {
        history.back(); // back to the page the lightbox was opened from
      }
    });
    window.addEventListener('popstate', () => {
      // Going back out of the lightbox mustn't restore the scroll position from when
      // it opened (that would undo keepTileInView); see open().
      history.scrollRestoration = 'auto';
      // Browser back while open closes the lightbox.
      if (!pushedHistory) return;
      pushedHistory = false;
      document.title = pageTitle;
      lightbox.pswp?.close();
    });

    const open = (index: number) => {
      pageTitle = document.title;
      openedAt = index;
      if (slides[index]?.href) {
        history.scrollRestoration = 'manual';
        history.pushState({ lightbox: true }, '', slides[index].href);
        pushedHistory = true;
        showInUrl(index);
      }
      lightbox.loadAndOpen(index);
    };

    for (const root of roots) {
      root.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('[data-slide]');
        if (!el || !root.contains(el)) return;
        // Links inside a clickable photo (e.g. prev/next on photo pages) stay links.
        const link = (e.target as HTMLElement).closest('a');
        if (link && link !== el && el.contains(link)) return;
        // Let modified clicks open the photo page (new tab, etc.).
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        open(Number(el.dataset.slide));
      });
      // Links already turn Enter into a click; this covers non-link tiles.
      root.addEventListener('keydown', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('[data-slide]');
        if (!el || el.tagName === 'A' || !root.contains(el) || (e.key !== 'Enter' && e.key !== ' ')) return;
        e.preventDefault();
        open(Number(el.dataset.slide));
      });
    }

    lightbox.init();
  }

  // Group the data blocks: those inside the same [data-lightbox-group] share a lightbox.
  const groups = new Map<Element, HTMLScriptElement[]>();
  for (const block of document.querySelectorAll<HTMLScriptElement>('script[data-lightbox]')) {
    const key = document.getElementById(block.dataset.lightbox!)?.closest('[data-lightbox-group]') ?? block;
    groups.set(key, [...(groups.get(key) ?? []), block]);
  }
  groups.forEach(setup);
</script>
