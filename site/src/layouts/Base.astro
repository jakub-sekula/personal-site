---
// HTML shell, ported from the old app/layout.tsx + ThemeWrapper.
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Ask search engines not to index this page. */
  noindex?: boolean;
}

const { title = 'Jakub Sekula', description = 'Web developer, mechanical engineer, and photography enthusiast.', image, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <script is:inline>
      // Same behaviour as next-themes on the old site: dark by default, choice kept in localStorage("theme").
      (() => {
        let theme = 'dark';
        try {
          theme = localStorage.getItem('theme') || 'dark';
        } catch {}
        if (theme === 'system') theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.classList.toggle('dark', theme === 'dark');
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
  </head>
  <body class="bg-lightbg font-sans text-text dark:bg-darkbg dark:text-darktext">
    <div class="bg-noisy opacity-0 dark:opacity-50"></div>
    <slot />
    <script>
      // Fade sections in as they scroll into view (old lib/utils `reveal`).
      function reveal() {
        const limit = window.innerHeight - 50;
        document.querySelectorAll('.reveal:not(.active)').forEach((el) => {
          if (el.getBoundingClientRect().top < limit) el.classList.add('active');
        });
      }
      reveal();
      window.addEventListener('scroll', reveal, { passive: true });
    </script>
  </body>
</html>
