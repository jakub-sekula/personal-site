---
// HTML shell, ported from the old app/layout.tsx + ThemeWrapper.
import '../styles/global.css';
import { pagePath } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** Link-preview image (og:image); relative URLs are made absolute. */
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  /** What the link-preview image shows (og:image:alt). */
  imageAlt?: string;
  /** Ask search engines not to index this page. (Every page asks AI crawlers not to use it.) */
  noindex?: boolean;
}

const { title = 'Jakub Sekula', description = 'Web developer, mechanical engineer, and photography enthusiast.', image, imageWidth, imageHeight, imageAlt, noindex = false } = Astro.props;
const imageUrl = image && new URL(image, Astro.site);
const canonical = new URL(pagePath(Astro.url), Astro.site);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* noai/noimageai: no use of the text or images for AI training (see public/robots.txt). */}
    <meta name="robots" content={noindex ? 'noindex, noai, noimageai' : 'noai, noimageai'} />
    {/* EU text-and-data-mining opt-out (TDMRep; also /.well-known/tdmrep.json). */}
    <meta name="tdm-reservation" content="1" />
    <link rel="canonical" href={canonical} />
    {/* favicon.ico (16–48px) for old browsers, the 512px PNG for the rest, 180px for iOS home screens. */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jakub Sekula" />
    <meta property="og:locale" content="en_GB" />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:type" content={imageUrl.pathname.endsWith('.png') ? 'image/png' : imageUrl.pathname.endsWith('.webp') ? 'image/webp' : 'image/jpeg'} />}
    {imageUrl && imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageUrl && imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    {imageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {imageUrl && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    {/* Structured data and other per-page tags. */}
    <slot name="head" />
    <script is:inline>
      // Same behaviour as next-themes on the old site: dark by default, choice kept in localStorage("theme").
      (() => {
        let theme = 'dark';
        try {
          theme = localStorage.getItem('theme') || 'dark';
        } catch {}
        if (theme === 'system') theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.classList.toggle('dark', theme === 'dark');
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
  </head>
  <body class="bg-lightbg font-sans text-text dark:bg-darkbg dark:text-darktext">
    <div class="bg-noisy opacity-0 dark:opacity-50"></div>
    <slot />
    <script>
      // Fade sections in as they scroll into view (old lib/utils `reveal`).
      function reveal() {
        const limit = window.innerHeight - 50;
        document.querySelectorAll('.reveal:not(.active)').forEach((el) => {
          if (el.getBoundingClientRect().top < limit) el.classList.add('active');
        });
      }
      reveal();
      window.addEventListener('scroll', reveal, { passive: true });
    </script>
  </body>
</html>
