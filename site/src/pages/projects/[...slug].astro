---
// Port of the old app/projects/[project]/page.tsx
import type { GetStaticPaths } from 'astro';
import { getEntries, render } from 'astro:content';
import { Image } from 'astro:assets';
import Page from '../../layouts/Page.astro';
import Icon from '../../components/Icon.astro';
import Tag from '../../components/common/Tag.astro';
import ToolCard from '../../components/common/ToolCard.astro';
import BlogPostCard from '../../components/blog/BlogPostCard.astro';
import { mdxComponents } from '../../components/mdx';
import { getProjects, isVisible, tagSlug } from '../../lib/content';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { title, excerpt, cover, github, demo, tags } = project.data;
const { Content } = await render(project);
const tools = await getEntries(project.data.tools);
const posts = (await getEntries(project.data.posts)).filter(isVisible);
const hasDescription = !!project.body?.trim();
---

<Page title={`${title} - Jakub Sekula`} description={excerpt ?? 'Generic project'} image={cover.src}>
  <main class="mx-auto mt-6 grid w-full max-w-6xl grid-cols-12 gap-2 px-6 md:mt-6 lg:mt-12 xl:px-4 2xl:px-0 pt-16">
    <div class="col-span-full flex flex-col items-center gap-4">
      <a href="/projects" class="flex gap-1 text-sm font-light  ">
        <Icon name="chevron-left" size={16} /> Back to projects
      </a>
      <h1 class="font-heading text-3xl font-bold leading-none md:text-4xl lg:text-6xl">{title}</h1>
      <p class="max-w-[75ch] text-center text-sm font-light">{excerpt}</p>
      {
        tags.length > 0 && (
          <ul class="col-span-full flex gap-4">
            {tags.map((tag) => (
              <Tag href={`/tags/${tagSlug(tag)}`} title={tag} />
            ))}
          </ul>
        )
      }
    </div>
    {
      (github || demo) && (
        <div class="col-span-full mx-auto mb-6 mt-3 flex gap-4">
          {github && (
            <a href={github} class="group flex w-max items-center gap-2 hover:underline">
              <Icon name="github" size={18} /> Github link
            </a>
          )}
          {demo && (
            <a href={demo} class="group flex w-max items-center gap-2 hover:underline">
              <Icon name="circle-play" size={18} /> Live demo
            </a>
          )}
        </div>
      )
    }
    <Image
      src={cover}
      alt={title}
      widths={[750, 1100, 1920]}
      sizes="(min-width: 1152px) 1104px, 100vw"
      loading="eager"
      class="col-span-full mx-auto md:mb-12 mb-6 md:mt-10 aspect-video w-full rounded-md object-cover shadow-xl"
    />
    <div class="col-span-full mb-12 flex flex-col gap-12 md:flex-row">
      {
        hasDescription && (
          <div class:list={['mx-auto w-full max-w-3xl font-light', tools.length > 0 && 'md:w-1/2']}>
            <h2 class="font-heading text-xl font-semibold">Description</h2>
            <Content components={mdxComponents} />
          </div>
        )
      }
      {
        tools.length > 0 && (
          <div class="grid w-full grid-cols-12 gap-2 md:w-1/2 ">
            <h2 class="col-span-full font-heading text-xl font-semibold">Tools used</h2>
            {tools.map((tool) => (
              <ToolCard tool={tool} class="col-span-6 md:col-span-4" />
            ))}
          </div>
        )
      }
    </div>
    {
      posts.length > 0 && (
        <div class="col-span-full grid grid-cols-12 gap-4 md:gap-5 lg:gap-7">
          <h2 class="col-span-full font-heading text-xl font-semibold">Related blog posts</h2>
          {posts.map((post) => (
            <BlogPostCard post={post} />
          ))}
        </div>
      )
    }
  </main>
</Page>
