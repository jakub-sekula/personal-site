---
// Port of the old app/projects/[project]/page.tsx. A project is a post with extras: the
// same MDX body and layouts ("story" opens with its cover photo full screen).
import type { GetStaticPaths } from 'astro';
import { getEntries, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import Tag from '../../components/common/Tag.astro';
import ToolCard from '../../components/common/ToolCard.astro';
import ProjectImage from '../../components/common/ProjectImage.astro';
import StoryArticle from '../../components/StoryArticle.astro';
import BlogPostCard from '../../components/blog/BlogPostCard.astro';
import { mdxComponents } from '../../components/mdx';
import { getPhoto } from '../../lib/photos';
import { categoryLabel, getProjects, isVisible, tagSlug } from '../../lib/content';

// Every project has a page, listed or not (a hidden category only leaves it out of lists).
export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { title, description, cover, github, demo, tags } = project.data;
const { Content } = await render(project);
const tools = await getEntries(project.data.tools);
const posts = (await getEntries(project.data.posts)).filter(isVisible);
const category = await categoryLabel(project);
const coverPhoto = project.data.coverPhoto ? getPhoto(project.data.coverPhoto) : undefined;
const story = project.data.format === 'story';
const hasBody = !!project.body?.trim();
const preview = cover
  ? { image: cover.src }
  : coverPhoto && { image: coverPhoto.og.url, imageWidth: coverPhoto.og.width, imageHeight: coverPhoto.og.height };
---

<Base title={`${title} - Jakub Sekula`} description={description ?? 'Generic project'} {...preview} noindex>
  <SiteHeader overHero={story && !!coverPhoto} />

  {
    story ? (
      <StoryArticle title={title} description={description} kicker={category} coverPhoto={coverPhoto?.src}>
        <div slot="intro" class="mx-auto flex max-w-[42rem] flex-col gap-4 px-6 pt-8">
          {tags.length > 0 && (
            <ul class="flex flex-wrap gap-2">
              {tags.map((tag) => (
                <Tag href={`/tags/${tagSlug(tag)}`} title={tag} />
              ))}
            </ul>
          )}
          {(github || demo) && (
            <div class="flex gap-4">
              {github && (
                <a href={github} class="group flex w-max items-center gap-2 hover:underline">
                  <Icon name="github" size={18} /> Github link
                </a>
              )}
              {demo && (
                <a href={demo} class="group flex w-max items-center gap-2 hover:underline">
                  <Icon name="circle-play" size={18} /> Live demo
                </a>
              )}
            </div>
          )}
        </div>
        <Content components={mdxComponents} />
        <div slot="after" class="mx-auto flex max-w-6xl flex-col gap-12 px-6 pb-12">
          {tools.length > 0 && (
            <div class="grid w-full grid-cols-12 gap-2">
              <h2 class="col-span-full font-heading text-xl font-semibold">Tools used</h2>
              {tools.map((tool) => (
                <ToolCard tool={tool} class="col-span-6 md:col-span-3" />
              ))}
            </div>
          )}
          {posts.length > 0 && (
            <div class="grid grid-cols-12 gap-4 md:gap-5 lg:gap-7">
              <h2 class="col-span-full font-heading text-xl font-semibold">Related blog posts</h2>
              {posts.map((post) => (
                <BlogPostCard post={post} />
              ))}
            </div>
          )}
        </div>
      </StoryArticle>
    ) : (
      <main class="mx-auto mt-6 grid w-full max-w-6xl grid-cols-12 gap-2 px-6 pt-16 md:mt-6 lg:mt-12 xl:px-4 2xl:px-0">
        <div class="col-span-full flex flex-col items-center gap-4">
          <a href="/projects" class="flex gap-1 text-sm font-light">
            <Icon name="chevron-left" size={16} /> Back to projects
          </a>
          <h1 class="font-heading text-3xl leading-none font-bold md:text-4xl lg:text-6xl">{title}</h1>
          <p class="max-w-[75ch] text-center text-sm font-light">{description}</p>
          {tags.length > 0 && (
            <ul class="col-span-full flex gap-4">
              {tags.map((tag) => (
                <Tag href={`/tags/${tagSlug(tag)}`} title={tag} />
              ))}
            </ul>
          )}
        </div>
        {(github || demo) && (
          <div class="col-span-full mx-auto mt-3 mb-6 flex gap-4">
            {github && (
              <a href={github} class="group flex w-max items-center gap-2 hover:underline">
                <Icon name="github" size={18} /> Github link
              </a>
            )}
            {demo && (
              <a href={demo} class="group flex w-max items-center gap-2 hover:underline">
                <Icon name="circle-play" size={18} /> Live demo
              </a>
            )}
          </div>
        )}
        {(cover || coverPhoto) && (
          <ProjectImage
            project={project}
            widths={[750, 1100, 1920]}
            sizes="(min-width: 1152px) 1104px, 100vw"
            eager
            class="col-span-full mx-auto mb-6 aspect-video w-full rounded-md object-cover shadow-xl md:mt-10 md:mb-12"
          />
        )}
        <div class="col-span-full mb-12 flex flex-col gap-12 md:flex-row">
          {hasBody && (
            <div
              data-lightbox-group
              class:list={[
                'prose mx-auto w-full max-w-3xl font-light dark:prose-invert prose-headings:font-heading prose-img:rounded-xs visited:prose-a:text-purple-400 dark:visited:prose-a:text-purple-600',
                tools.length > 0 && 'md:w-1/2',
              ]}
            >
              <Content components={mdxComponents} />
            </div>
          )}
          {tools.length > 0 && (
            <div class="grid w-full grid-cols-12 gap-2 md:w-1/2">
              <h2 class="col-span-full font-heading text-xl font-semibold">Tools used</h2>
              {tools.map((tool) => (
                <ToolCard tool={tool} class="col-span-6 md:col-span-4" />
              ))}
            </div>
          )}
        </div>
        {posts.length > 0 && (
          <div class="col-span-full grid grid-cols-12 gap-4 md:gap-5 lg:gap-7">
            <h2 class="col-span-full font-heading text-xl font-semibold">Related blog posts</h2>
            {posts.map((post) => (
              <BlogPostCard post={post} />
            ))}
          </div>
        )}
      </main>
    )
  }
  <Footer />
</Base>
