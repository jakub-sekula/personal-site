---
// Port of the old app/blog/[post]/page.jsx + MarkdownRenderer.
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TableOfContents from '../../components/common/TableOfContents.astro';
import { mdxComponents } from '../../components/mdx';
import Picture from '../../components/photos/Picture.astro';
import Cover from '../../components/photos/Cover.astro';
import { getPhoto } from '../../lib/photos';
import { getPosts, tagSlug } from '../../lib/content';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, headings } = await render(post);
const coverPhoto = post.data.coverPhoto ? getPhoto(post.data.coverPhoto) : undefined;
const story = post.data.format === 'story';
const date = post.data.date.toLocaleDateString('en-gb');
const preview = post.data.cover
  ? { image: post.data.cover.src }
  : coverPhoto && { image: coverPhoto.og.url, imageWidth: coverPhoto.og.width, imageHeight: coverPhoto.og.height };

// Nest h3s under their h2, as the old client-side table of contents did.
const toc: { id: string; title: string; items: { id: string; title: string }[] }[] = [];
for (const h of headings) {
  if (h.depth === 2) toc.push({ id: h.slug, title: h.text, items: [] });
  else if (h.depth === 3 && toc.length) toc.at(-1)!.items.push({ id: h.slug, title: h.text });
}
---

<Base title={`${post.data.title} - Jakub Sekula`} description={post.data.description} {...preview}>
  <Header overHero={story && !!coverPhoto} />
  {
    story && (
      <main>
        {coverPhoto ? (
          <Cover photo={coverPhoto.src} eager id="hero-section" class="my-0!">
            <p class="text-sm opacity-80">{date}</p>
            <h1>{post.data.title}</h1>
            {post.data.description && <p>{post.data.description}</p>}
          </Cover>
        ) : (
          <header class="mx-auto max-w-[42rem] px-6 pt-32">
            <div class="mb-4 text-sm font-light">{date}</div>
            <h1 class="font-heading text-5xl font-bold tracking-tight">{post.data.title}</h1>
            {post.data.description && <p class="mt-4 text-lg font-light opacity-80">{post.data.description}</p>}
          </header>
        )}
        {/* Every photo in the story opens in one lightbox, in reading order. */}
        <article
          data-lightbox-group
          class="story prose max-w-none pt-12 pb-20 font-light md:prose-lg dark:prose-invert prose-headings:font-heading prose-headings:tracking-tight visited:prose-a:text-purple-400 dark:visited:prose-a:text-purple-600"
        >
          <Content components={mdxComponents} />
        </article>
      </main>
    )
  }
  {
    !story && (
      <main class="mx-auto grid w-full max-w-page grid-cols-12 pt-16">
        {
          (post.data.cover || coverPhoto) && (
            <div
              class="relative col-span-full mx-auto aspect-video max-h-[480px]
                         w-full overflow-hidden rounded-b-xl lg:col-span-10 lg:col-start-2
                         lg:mt-8 lg:rounded-xl"
            >
              {post.data.cover ? (
                <Image src={post.data.cover} alt={post.data.title} widths={[960, 1920]} sizes="(min-width: 1024px) 1125px, 100vw" loading="eager" class="absolute h-full w-full object-cover" />
              ) : (
                <Picture src={coverPhoto!.src} alt={post.data.title} sizes="(min-width: 1024px) 1125px, 100vw" eager class="absolute h-full w-full object-cover" />
              )}
            </div>
          )
        }
        <div class="col-span-full px-6 pb-6 pt-8 md:col-span-8 md:col-start-3 lg:col-span-10 lg:col-start-2 lg:px-0 col-span-full ">
          <div class="mb-4 block text-sm font-light">{date}</div>
          <div class="mb-2 flex gap-2">
            {
              post.data.tags.map((tag) => (
                <a
                  href={`/tags/${tagSlug(tag)}`}
                  class="rounded-xs bg-darkbg px-2 py-0.5 text-xs
                          text-darktext dark:bg-darktext dark:text-text"
                >
                  {tag}
                </a>
              ))
            }
          </div>
          <h1 class="-mb-3 font-heading text-3xl font-semibold tracking-tight ">{post.data.title}</h1>
        </div>

        <div
          data-lightbox-group
          class="prose-pre:overflow-x-none prose col-span-full row-start-3 w-full max-w-none
    				  px-6 font-light prose-pre:m-0 prose-pre:h-min prose-pre:p-0
    				dark:prose-invert md:col-span-8 md:col-start-3 lg:px-0 lg:col-span-7 lg:col-start-2 lg:pr-24 prose-img:rounded-xs visited:prose-a:text-purple-400 dark:visited:prose-a:text-purple-600"
        >
          <Content components={mdxComponents} />
        </div>

        <aside class="sticky top-20 col-span-3 col-start-9 row-start-3 hidden h-min lg:block">
          <h4 class="mb-2 font-heading text-lg font-semibold">In this post:</h4>
          <ul class="font-light">
            <TableOfContents headings={toc} depth={2} />
          </ul>
        </aside>
      </main>
    )
  }
  <Footer />
</Base>
