---
// Port of the old app/photography/[category]/page.tsx + LightboxWrapper.
// An album with an MDX body is laid out by it (text, <Photo>, <Row>, <Side>,
// <AlbumGrid> …); without one, the page is the classic grid of every photo.
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Photography from '../../layouts/Photography.astro';
import Icon from '../../components/Icon.astro';
import Picture from '../../components/photos/Picture.astro';
import Cover from '../../components/photos/Cover.astro';
import PhotoGrid from '../../components/photos/PhotoGrid.astro';
import { mdxComponents } from '../../components/mdx';
import { albumCover, albumName, albumPhotos, getAlbums, getChildAlbums, getParentAlbum, withCovers } from '../../lib/content';
import { getPhoto } from '../../lib/photos';
import { author, jsonLd, listOf, seoTrim } from '../../lib/seo';
import { shareImage } from '../../lib/share';

export const getStaticPaths = (async () => {
  const albums = await getAlbums();
  return albums.map((album) => ({ params: { album: album.id }, props: { album } }));
}) satisfies GetStaticPaths;

const { album } = Astro.props;
const { title } = album.data;
const description = album.data.description ?? '';
const { Content } = await render(album);
const hasLayout = !!album.body?.trim();
const fullHero = album.data.hero !== 'banner';
const children = await withCovers(await getChildAlbums(album));
// getAlbums() only returns albums with a cover (their own, or a fallback).
const coverSrc = (await albumCover(album))!;
const cover = getPhoto(coverSrc);
// Albums in a collection lead back to it.
const parent = await getParentAlbum(album);
const back = parent ? { href: `/photography/${parent.id}`, label: `Back to ${parent.data.title}` } : { href: '/photography', label: 'Back to albums' };
const photos = albumPhotos(album);

// Search results and link previews: "Iceland — Jakub Sekula Photography", the album's
// description (or one made from what's in it), and its share picture (src/lib/share.ts).
const name = albumName(album);
const count = (n: number, what: string) => `${n} ${what}${n === 1 ? '' : 's'}`;
const childNames = children.map((c) => albumName(c.album));
const metaDescription = seoTrim(
  description ||
    (children.length
      ? `Photos from ${listOf(childNames.length > 4 ? [...childNames.slice(0, 4), 'more'] : childNames)}, by Jakub Sekula.`
      : parent
        ? `${count(photos.length, 'photo')} from ${name}, by Jakub Sekula.`
        : `${name}: ${count(photos.length, 'photo')} by Jakub Sekula.`),
);
const share = shareImage(album.id, { title, cover: coverSrc, position: album.data.coverPosition });
const preview = share ?? cover.og;
const previewAlt = `${name}: ${children.length ? 'photo albums' : 'photos'} by Jakub Sekula`;
const absolute = (href: string) => new URL(href, Astro.site).href;
const structured = jsonLd({
  '@type': 'ImageGallery',
  name,
  description: metaDescription,
  url: absolute(`/photography/${album.id}`),
  image: absolute(preview.url),
  author,
  ...(children.length
    ? { hasPart: children.map((c) => ({ '@type': 'ImageGallery', name: albumName(c.album), url: absolute(`/photography/${c.album.id}`) })) }
    : { numberOfItems: photos.length }),
  ...(parent && { isPartOf: { '@type': 'ImageGallery', name: albumName(parent), url: absolute(`/photography/${parent.id}`) } }),
});
---

<Photography
  title={`${name} — Jakub Sekula Photography`}
  description={metaDescription}
  image={preview.url}
  imageWidth={preview.width}
  imageHeight={preview.height}
  imageAlt={previewAlt}
>
  <script slot="head" type="application/ld+json" set:html={structured} />
  {
    fullHero ? (
      // The cover photo full screen, edge to edge, above the sidebar (`hero: banner` for the old banner).
      <Cover slot="cover" photo={coverSrc} position={album.data.coverPosition} eager id="hero-section" class="my-0!">
        <a href={back.href} class="flex items-center gap-1 text-sm font-light">
          <Icon name="chevron-left" size={16} />
          {back.label}
        </a>
        <h1 class="uppercase">{title}</h1>
        {description && <p>{description}</p>}
      </Cover>
    ) : (
      <section class="relative flex h-screen max-h-[400px] max-w-[1920px] items-center justify-center overflow-hidden rounded-xs">
        <div class="absolute inset-0 z-10 h-full bg-linear-to-tr from-darkbg/90"></div>
        <Picture src={coverSrc} alt={title} sizes="(min-width: 1350px) 1080px, 100vw" eager class="absolute inset-0 z-0 mx-auto h-full w-full object-cover" />
        <div class="z-20 p-6 flex w-full max-w-page flex-col items-center text-white ">
          <a href={back.href} class="mb-4 flex items-center gap-1 text-sm font-light">
            <Icon name="chevron-left" size={16} />
            {back.label}
          </a>
          <h1
            class="mb-3 wrap-break-word font-heading text-3xl md:text-5xl font-bold
                    uppercase leading-none tracking-tight xl:text-[5.5rem] 2xl:text-[6rem]"
          >
            {title}
          </h1>
          <p class="max-w-[75ch] text-center text-sm font-light md:text-lg">{description}</p>
          {album.data.tags.map((tag) => <span>{tag}</span>)}
        </div>
      </section>
    )
  }

  {
    children.length > 0 && (
      <section class="col-span-full grid w-full max-w-page grid-cols-12 gap-4 py-4">
        {children.map(({ album: child, cover: childCover }) => (
          <a
            href={`/photography/${child.id}`}
            class="group relative col-span-full md:col-span-4 flex  flex-col items-center justify-center gap-4
                      overflow-hidden rounded-xs aspect-[2.5] md:aspect-3/2 px-3 py-6 font-bold dark:border-0"
          >
            <Picture
              src={childCover}
              alt={child.data.title}
              sizes="(min-width: 768px) 30vw, 100vw"
              class="absolute -z-10 h-full w-full object-cover transition-transform group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-linear-to-tr from-darkbg/50 " />
            <h6 class="z-10 font-heading text-2xl font-semibold uppercase text-white">{child.data.title}</h6>
          </a>
        ))}
      </section>
    )
  }

  {
    hasLayout ? (
      // Every photo on the page opens in one lightbox, in page order.
      <div data-lightbox-group class="story story-inset prose max-w-none pt-10 pb-12 font-light md:prose-lg dark:prose-invert prose-headings:font-heading prose-headings:tracking-tight">
        <Content components={mdxComponents} />
      </div>
    ) : (
      <PhotoGrid id={`gallery-${album.id}`} photos={photos} />
    )
  }
</Photography>
