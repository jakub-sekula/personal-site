---
// Port of the old app/photography/page.tsx
import { getEntry, getEntries } from 'astro:content';
import Photography from '../../layouts/Photography.astro';
import Picture from '../../components/photos/Picture.astro';
import { albumName, isVisible, withCovers } from '../../lib/content';
import { getPhoto } from '../../lib/photos';
import { author, jsonLd } from '../../lib/seo';
import { SHARE_INDEX, shareImage } from '../../lib/share';

const config = (await getEntry('photography', 'photography'))!.data;
const albums = await withCovers((await getEntries(config.index)).filter(isVisible));

// Link previews: the first album's cover with "Photography" on it (src/lib/share.ts).
const first = albums[0];
const preview = first && (shareImage(SHARE_INDEX, { title: 'Photography', cover: first.cover, position: first.album.data.coverPosition }) ?? getPhoto(first.cover).og);
const description = 'Photography by Jakub Sekula: travel and street photos from around the world, portraits, black and white, and film.';
const structured = jsonLd({
  '@type': 'CollectionPage',
  name: 'Photography',
  description,
  url: new URL('/photography', Astro.site).href,
  ...(preview && { image: new URL(preview.url, Astro.site).href }),
  author,
  hasPart: albums.map(({ album }) => ({ '@type': 'ImageGallery', name: albumName(album), url: new URL(`/photography/${album.id}`, Astro.site).href })),
});
---

<Photography
  title="Photography — Jakub Sekula"
  description={description}
  image={preview?.url}
  imageWidth={preview?.width}
  imageHeight={preview?.height}
  imageAlt="Photography by Jakub Sekula"
>
  <script slot="head" type="application/ld+json" set:html={structured} />
  <h1 class="sr-only">Photography</h1>
  <div class="col-span-full mx-auto grid w-full grid-cols-6 gap-4 md:gap-0">
    {
      albums.map(({ album, cover }) => (
        <a
          href={`/photography/${album.id}`}
          class="group relative col-span-full flex aspect-[2.5] w-full items-center justify-center overflow-hidden rounded-xs md:col-span-3 md:aspect-3/2 md:rounded-none"
        >
          <div class="absolute inset-0 bg-black/15 opacity-0 backdrop-blur-xs transition-all duration-300 group-hover:opacity-100" />
          <Picture
            src={cover}
            alt={album.data.title}
            sizes="(min-width: 768px) 40vw, 100vw"
            eager
            class="absolute -z-10 h-full w-full object-cover transition-all duration-500 group-hover:scale-105"
          />
          <h3 class="z-10 translate-y-2 font-heading text-5xl font-semibold uppercase text-white opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100">
            {album.data.title}
          </h3>
        </a>
      ))
    }
  </div>
</Photography>
